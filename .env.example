PORT=4000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/email_scheduler
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Email Scheduler <scheduler@example.test>
EMAIL_MAX_ATTEMPTS=3
EMAIL_RATE_LIMIT_PER_MINUTE=10
EMAIL_SEND_DELAY_MS=0
